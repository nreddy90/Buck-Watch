# TigerData PostgreSQL connection (preferred)
DB_URL='jdbc:postgresql://<your-tigerdata-host>:5432/buckwatch?user=<db_user>&password=<db_password>&sslmode=require'

# Optional local fallback values if you need a non-TigerData database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buckwatch
DB_USER=buckwatch
DB_PASSWORD=change_me_local_password

ML_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
BUCKWATCH_DEMO_ENABLED=true
DEMO_CURRENT_CITY=Atlanta, GA, United States
# Optional dataset provenance; CSV itself contains no observation-date column.
COST_INDEX_SOURCE=
COST_INDEX_OBSERVATION_DATE=
